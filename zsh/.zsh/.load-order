flutter.zsh
android.zsh
nginx.zsh
docker.zsh

vim.zsh
emacs.zsh
tmux.zsh

chore.zsh
alias.zsh         # 别名（可以使用前面的配置）
fzf-tab.zsh
dedupe-path.zsh   # PATH 去重兜底
